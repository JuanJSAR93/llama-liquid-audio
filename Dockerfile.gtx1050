# ===================================================
# STAGE 1: BUILDER
# Base oficial CUDA 12.4.1 (alineada con arquitectura Pascal sm_61)
# ===================================================
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    cmake \
    ninja-build \
    build-essential \
    pkg-config \
    libcurl4-openssl-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Configuración de stubs para enlazar el driver de CUDA durante la compilación
RUN ln -s /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1
ENV LIBRARY_PATH="/usr/local/cuda/lib64/stubs"
ENV CMAKE_LIBRARY_PATH="/usr/local/cuda/lib64/stubs"

# Copiar el código fuente local (con los parches de suspensión y audio)
COPY . /src/llama.cpp

WORKDIR /src/llama.cpp

# Configurar compilación con soporte CUDA (Compute Capability 6.1 para series GTX 1000)
RUN cmake -B build \
    -G Ninja \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES=61 \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_EXE_LINKER_FLAGS="-Wl,-rpath-link,/usr/local/cuda/lib64/stubs" \
    -DCMAKE_SHARED_LINKER_FLAGS="-Wl,-rpath-link,/usr/local/cuda/lib64/stubs"

# Compilar servidor de audio, cli y llama-bench
RUN cmake --build build \
    --target llama-liquid-audio-server llama-liquid-audio-cli llama-bench \
    -j$(nproc)


# ===================================================
# STAGE 2: RUNTIME
# ===================================================
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libcurl4 \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copiar todos los ejecutables y librerías de la carpeta bin/
COPY --from=builder /src/llama.cpp/build/bin/ /usr/local/bin/

ENV LD_LIBRARY_PATH=/usr/local/bin

WORKDIR /models

# Arrancar el servidor de audio modificado
ENTRYPOINT ["llama-liquid-audio-server"]
